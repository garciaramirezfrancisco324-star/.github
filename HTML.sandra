// server.js import express from "express"; import fs from "fs"; import path from "path"; const app = express(); const PORT = process.env.PORT || 3000; // Middleware para leer JSON del cuerpo app.use(express.json()); // Ruta para recibir métricas del script app.post("/metrics", (req, res) => { const metric = req.body; // Carpeta donde se guardarán las métricas const dir = path.resolve("./metrics"); if (!fs.existsSync(dir)) fs.mkdirSync(dir); // Guardar en archivo de texto con fecha const logFile = path.join(dir, "metrics.log"); const line = `${new Date().toISOString()} | ${metric.name} = ${metric.value} (${metric.rating}) [${metric.navigationType}]\n`; fs.appendFileSync(logFile, line); console.log("✅ Métrica recibida:", metric); res.status(200).json({ ok: true }); }); // Ruta simple para verificar que el servidor responde app.get("/", (req, res) => { res.send("
Servidor Web Vitals activo ✅
"); }); // Iniciar servidor app.listen(PORT, () => { console.log(`🚀 Servidor escuchando en http://localhost:${PORT}`); });
